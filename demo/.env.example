# Copy to demo/.env and fill in. NEVER commit the filled-in file.
# Names and descriptions only - no real values belong in this template.

# ---------------------------------------------------------------------------
# Authorization mode
#   devidp = local standards-based authorization server (no tenant required)
#   entra  = Microsoft Entra ID
# ---------------------------------------------------------------------------
AUTH_MODE=devidp

# ---------------------------------------------------------------------------
# Microsoft Entra ID (AUTH_MODE=entra)
# ---------------------------------------------------------------------------
ENTRA_TENANT_ID=
ENTRA_AUTHORITY=

# ---------------------------------------------------------------------------
# MCP Resource A - the protected refund MCP server
# MCP_A_CLIENT_SECRET is required only for the on-behalf-of exchange.
# Keep it in Key Vault in the cloud path; never commit it.
# ---------------------------------------------------------------------------
MCP_A_PUBLIC_URL=http://localhost:8801
MCP_A_AUDIENCE=api://refund-mcp-a
MCP_A_PORT=8801
MCP_A_CLIENT_ID=
MCP_A_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# MCP Resource B - second resource, MUST have a different audience
# ---------------------------------------------------------------------------
MCP_B_PUBLIC_URL=http://localhost:8802
MCP_B_AUDIENCE=api://refund-mcp-b
MCP_B_PORT=8802

# ---------------------------------------------------------------------------
# Upstream refund API - its own audience and delegated scope
# ---------------------------------------------------------------------------
UPSTREAM_API_URL=http://localhost:8803
UPSTREAM_API_AUDIENCE=api://refund-upstream
UPSTREAM_API_SCOPE=api://refund-upstream/Ledger.Refund
UPSTREAM_API_PORT=8803

# ---------------------------------------------------------------------------
# Approved MCP client applications (comma-separated client IDs)
# ---------------------------------------------------------------------------
ALLOWED_CLIENT_IDS=copilot-demo-client

# ---------------------------------------------------------------------------
# Microsoft Foundry model backing the assess_refund tool
# Leave FOUNDRY_API_KEY empty to use managed identity / DefaultAzureCredential.
# ---------------------------------------------------------------------------
FOUNDRY_ENDPOINT=
FOUNDRY_DEPLOYMENT=
FOUNDRY_API_VERSION=2024-10-21
FOUNDRY_API_KEY=

# ---------------------------------------------------------------------------
# Telemetry
# ---------------------------------------------------------------------------
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ---------------------------------------------------------------------------
# Policy
# ---------------------------------------------------------------------------
REFUND_PER_CALL_LIMIT_MINOR=25000
REFUND_CURRENCY=CAD
POLICY_VERSION=refund-policy/2026-10-06.1

# ---------------------------------------------------------------------------
# Local devidp
# ---------------------------------------------------------------------------
DEVIDP_PORT=8800
DEVIDP_ISSUER=http://localhost:8800
